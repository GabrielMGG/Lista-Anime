# Referência: este projeto NÃO carrega arquivos .env automaticamente.
# Defina as variáveis no PowerShell ou na configuração de execução do IntelliJ.
# Preencha as credenciais somente localmente.
DB_USER=
DB_PASSWORD=

# Opcionais, com os padrões locais:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/anime_mood
SERVER_PORT=8080

# Catálogo oficial opcional; defina somente no processo do backend.
MAL_CLIENT_ID=
